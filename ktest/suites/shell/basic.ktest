# Built-in commands that don't fit the dedicated suites below.

> pwd
~ ^/

> cd /tmp && pwd
< /tmp

> cd / && pwd
< /

> :
> echo $?
< 0

> true && echo ok || echo no
< ok

> false && echo ok || echo no
< no

> echo $(( 0 ))
< 0

> echo a b c | tr ' ' ,
< a,b,c

> echo hi > /tmp/b.txt && cat /tmp/b.txt
< hi
