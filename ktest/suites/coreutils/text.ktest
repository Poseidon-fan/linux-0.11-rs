# Text-processing coreutils: wc/head/tail/sort/uniq/tr/cut/nl/od/...
#
# Each block follows the pattern:
#   1. Build a fixture under /tmp/kt-text/ (we created the dir up front).
#   2. Run the command, assert on its output.
#   3. (Optional) check $?.
# We tear the scratch dir down at the end. Reference outputs come from
# host GNU coreutils — minor formatting differences (extra leading
# whitespace, locale tweaks) are tolerated via `~` regex.

> rm -rf /tmp/kt-text && mkdir /tmp/kt-text

# --- echo --------------------------------------------------------------

> echo hello world
< hello world

> echo
<

> echo -n hi
< hi

# --- printf ------------------------------------------------------------

> printf '%s-%s\n' a b
< a-b

> printf '%d\n' 42
< 42

# --- cat ---------------------------------------------------------------

> printf 'l1\nl2\nl3\n' > /tmp/kt-text/three
> cat /tmp/kt-text/three
< l1
< l2
< l3

> cat /tmp/kt-text/three | cat
< l1
< l3

# --- wc ----------------------------------------------------------------

> echo abc | wc -c
~ ^\s*4\b

> echo abc | wc -l
~ ^\s*1\b

> echo one two three four | wc -w
~ ^\s*4\b

> wc -l /tmp/kt-text/three
~ ^\s*3\b.*three

# --- head / tail -------------------------------------------------------

> printf 'a\nb\nc\nd\ne\n' > /tmp/kt-text/five
> head -n 2 /tmp/kt-text/five
< a
< b

> head -n 1 /tmp/kt-text/five
< a

> tail -n 2 /tmp/kt-text/five
< d
< e

> tail -n 1 /tmp/kt-text/five
< e

# --- tr ----------------------------------------------------------------

> echo HelloWorld | tr A-Z a-z
< helloworld

> echo abc | tr -d b
< ac

> printf 'a   b   c\n' | tr -s ' '
< a b c

# --- cut ---------------------------------------------------------------

> echo 'one two three' | cut -d ' ' -f 2
< two

> echo 'one two three' | cut -d ' ' -f 1,3
< one three

> echo 'abcdef' | cut -c 2-4
< bcd

# --- sort --------------------------------------------------------------

> printf 'banana\napple\ncherry\n' | sort
< apple
< banana
< cherry

> printf 'banana\napple\ncherry\n' | sort -r
< cherry
< banana
< apple

# Numeric sort orders by value, not lexically (10 after 2).
> printf '10\n2\n1\n' | sort -n
< 1
< 2
< 10

# General-numeric sort handles exponents (1.5e3 == 1500); this path runs
# real x87 floating-point and exercises the kernel's lazy FPU switching.
> printf '3.14\n2\n10\n1.5e3\n' | sort -g
< 2
< 3.14
< 10
< 1.5e3

> printf 'b\na\nb\na\n' | sort -u
< a
< b

> printf 'a:3\nb:1\nc:2\n' | sort -t: -k2
< b:1
< c:2
< a:3

> printf 'c\na\nb\n' | sort -o /tmp/kt-text/sorted
> cat /tmp/kt-text/sorted
< a
< b
< c

# --- uniq --------------------------------------------------------------

> printf 'a\na\nb\nb\nb\nc\n' | uniq
< a
< b
< c

> printf 'a\na\nb\n' | uniq -c
~ \s*2\s+a
~ \s*1\s+b

# --- nl ----------------------------------------------------------------

> printf 'x\ny\n' | nl
~ \s*1\s+x
~ \s*2\s+y

# --- fold --------------------------------------------------------------

> echo abcdefgh | fold -w 3
< abc
< def
< gh

# --- paste -------------------------------------------------------------

> printf 'a\nb\n' > /tmp/kt-text/p1
> printf '1\n2\n' > /tmp/kt-text/p2
> paste /tmp/kt-text/p1 /tmp/kt-text/p2
~ a\s+1
~ b\s+2

# --- tee ---------------------------------------------------------------

> echo via-tee | tee /tmp/kt-text/teed
< via-tee
> cat /tmp/kt-text/teed
< via-tee

# --- expand / unexpand -------------------------------------------------

> printf 'a\tb\n' | expand
~ a +b

# --- od ----------------------------------------------------------------

> printf 'abc' | od -t c
~ 0000000\s+a\s+b\s+c

# --- base64 ------------------------------------------------------------

> echo abc | base64
< YWJjCg==

> echo YWJjCg== | base64 -d
< abc

# --- cksum -------------------------------------------------------------

> printf 'abc\n' | cksum
~ 1112837078 4

# --- xargs -------------------------------------------------------------

# Default: collect all items onto one `echo` command line.
> printf 'a\nb\nc\n' | xargs echo
< a b c

# Items also feed an explicit command after its own initial arguments.
> printf 'x\ny\n' | xargs echo PRE
< PRE x y

# -n batches items, running the command once per group.
> printf '1 2 3 4 5\n' | xargs -n2 echo
< 1 2
< 3 4
< 5

# -I substitutes each input line into the command template.
> printf 'foo\nbar\n' | xargs -I{} echo item={}
< item=foo
< item=bar

# -0 splits on NUL, so embedded spaces stay within one item.
> printf 'a\0b c\0' | xargs -0 -n1 echo
< a
< b c

# Single quotes group whitespace into one item.
> printf '%s\n' "'a b' c" | xargs -n1 echo
< a b
< c

# -r suppresses the run on empty input (no output, success).
> printf '' | xargs -r echo SHOULD_NOT_APPEAR
> echo rc=$?
< rc=0

# --- cleanup -----------------------------------------------------------

> rm -rf /tmp/kt-text
